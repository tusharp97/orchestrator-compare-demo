# Docker, dbt, and the demo scripts must keep LF so the same files run on
# macOS and Linux after being edited or copied from Windows.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*/Dockerfile text eol=lf
*.ps1 text eol=lf
*.png binary
*.jpg binary
